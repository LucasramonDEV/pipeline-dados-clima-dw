# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
venv/
env/

# Environment variables
.env

# Local data artifacts (keep folder structure via .gitkeep)
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep
data/gold/*
!data/gold/.gitkeep
logs/*
!logs/.gitkeep

# Testing & coverage
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# Prefect / Airflow local state
.prefect/
airflow.db
airflow.cfg
webserver_config.py

# OS / IDE files
.DS_Store
.vscode/
.idea/
*.swp
